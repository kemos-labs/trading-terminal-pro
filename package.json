{
  "name": "trading-terminal-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,macro \"vite\" \"node server.js\" \"npm run rates-worker\"",
    "rates-worker": "python3 -m uvicorn main:app --app-dir services/rates-worker --host 127.0.0.1 --port 8765",
    "macrovol-api": "npm run rates-worker",
    "build": "tsc -b && vite build",
    "start": "node server.js",
    "start:prod": "bash scripts/start-production.sh",
    "type-check": "tsc -b --noEmit --pretty false",
    "lint": "oxlint",
    "report:routes": "node scripts/route-parity.mjs --write --list",
    "report:bundle": "node scripts/bundle-report.mjs",
    "report:screenshots": "node scripts/collect-screenshot-manifest.mjs",
    "preview": "vite preview",
    "test": "NODE_ENV=test vitest",
    "test:ui": "NODE_ENV=test vitest --ui",
    "test:coverage": "NODE_ENV=test vitest --coverage",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "generate:workflows": "node scripts/generate-workflow-registry.mjs",
    "test:route-parity": "node scripts/route-parity.mjs",
    "test:api-contracts": "node scripts/generate-workflow-registry.mjs --check && node scripts/route-parity.mjs && node scripts/validate-openapi.mjs && NODE_ENV=test vitest run server/routes/v1.test.js",
    "test:mcp-contracts": "NODE_ENV=test vitest run mcp/mcp-contracts.test.ts",
    "test:integration": "NODE_ENV=test vitest run server/routes/restoredRoutes.test.js server/routes/v1.test.js server/quota.test.js api/upstreamCache.test.js server/providers/freeCrypto/client.test.js server/providers/entitlements.test.js && NODE_ENV=test vitest run server/providers/deribit/quota.integration.test.js",
    "test:e2e:mocked": "npx playwright test --reporter=line",
    "test:e2e:real-server": "npm run build && npx playwright test --config=playwright.real-server.config.ts",
    "test:e2e:failure-states": "npm run build && npx playwright test --config=playwright.failure-states.config.ts",
    "smoke:api": "bash scripts/smoke-api.sh",
    "test:visual": "npx playwright test --config=playwright.visual.config.ts",
    "mcp": "node mcp/mcp-server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fastify": "^5.3.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-window": "^2.2.7",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.3.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.6.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^3.0.9",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.0.9"
  }
}
