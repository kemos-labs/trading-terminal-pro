          "type": "integer",
          "const": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "INVALID_SYMBOL",
                "UNSUPPORTED_CURRENCY",
                "PROVIDER_UNAVAILABLE",
                "INSUFFICIENT_COVERAGE",
                "RATE_LIMITED",
                "ENTITLEMENT_MISSING",
                "INTERNAL_CONTRACT_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "retryable": {
              "type": "boolean"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "providerStatusData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerModes",
        "cache",
        "quota",
        "circuits"
      ],
      "properties": {
        "providerModes": {
          "type": "object"
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entries",
            "hits",
            "misses",
            "inflight"
          ],
          "properties": {
            "entries": {
              "type": "integer",
              "minimum": 0
            },
            "hits": {
              "type": "integer",
              "minimum": 0
            },
            "misses": {
              "type": "integer",
              "minimum": 0
            },
            "inflight": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "persistent", "healthy", "providers"],
          "properties": {
            "scope": { "type": "string", "enum": ["persistent-file-single-process", "process-local"] },
            "persistent": { "type": "boolean" },
            "healthy": { "type": "boolean" },
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["provider", "period", "used", "cap", "remaining"],
                "properties": {
                  "provider": { "type": "string", "enum": ["fmp", "alphavantage", "finnhub", "tradingview"] },
                  "period": { "type": "string", "enum": ["day", "month"] },
                  "used": { "type": "integer", "minimum": 0 },
                  "cap": { "type": "integer", "minimum": 1 },
                  "remaining": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "circuits": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": { "type": "object", "properties": { "provider": { "const": "deribit" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "properties": { "provider": { "const": "binance-futures" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "properties": { "provider": { "const": "bybit-linear" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "properties": { "provider": { "const": "bybit-options" } } },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "type": "object", "properties": { "provider": { "const": "okx-options" } } },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "status", "failures", "cooldownRemainingMs", "probeInFlight"],
            "properties": {
              "provider": { "type": "string", "enum": ["deribit", "binance-futures", "bybit-linear", "bybit-options", "okx-options"] },
              "status": { "type": "string", "enum": ["closed", "open", "half-open"] },
              "failures": { "type": "integer", "minimum": 0 },
              "cooldownRemainingMs": { "type": "integer", "minimum": 0 },
              "probeInFlight": { "type": "boolean" }
            }
          }
        }
      }
    },
