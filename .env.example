# Trading Terminal Pro — Environment Configuration

# Server
PORT=3001

# REQUIRED for live market data (option chain, quotes, treasury rates).
# Get a key at https://financialmodelingprep.com/ and set it here.
# Without it, the server still runs but live mode and FMP enrichment return 503.
FMP_API_KEY=your_fmp_key_here

# Comma-separated list of origins allowed by CORS. Defaults to localhost dev origins.
# Set this to your deployed frontend URL in production, e.g.:
# CORS_ORIGIN=https://your-app.vercel.app
# Railway also allows the exact RAILWAY_PUBLIC_DOMAIN host (no *.up.railway.app wildcard).

# Ops only: include boolean key-presence flags on GET /api/cache/status (default off).
# EXPOSE_KEY_STATUS=1

# MacroVol debug routes (/api/debug/*) are off by default. Never enable in production.
# MACROVOL_DEBUG=0

# Yahoo Finance fallback (Python yfinance) — optional; FMP is the default live source.
# YAHOO_API_KEY=your_key_here

# MacroVol FastAPI (FRED macro/rates + yfinance greeks/IV surface).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Put FRED_API_KEY in macrovol-api/.env (preferred) or export before starting the API.
# FRED_API_KEY=your_fred_key_here
# MACROVOL_API_URL=http://127.0.0.1:8765
# ALLOW_STIR_FALLBACK=0   # keep 0: never mix stale SR3/ZQ fallbacks with live quotes

# Finnhub free tier — news, earnings, SPY quote (server-only; never expose to browser).
# Shared cache: all Railway visitors read one board; warmer refreshes on a schedule.
# https://finnhub.io/register
# FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage free (~25 req/day) — SPY GLOBAL_QUOTE + daily bars + overview.
# Server-only. Hard daily budget + ~90 min shared TTL. Never in browser.
# https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# TradingView data via RapidAPI (~150 req/month on free/hobby plans).
# Server-only. Used for SPY/BTC snapshot only — NOT SOFR/EFFR (use NY Fed/FRED).
# Hard monthly budget + multi-hour shared TTL.
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_TV_HOST=tradingview-data1.p.rapidapi.com

# OPRA paid options stream (PR-10 skeleton — off by default)
# Do not put vendor secrets in the browser. Server-only.
# OPRA_ENABLED=0
# OPRA_VENDOR=stub          # stub | polygon | livevol
# OPRA_API_KEY=             # future vendor credential (server-side only)

# Massive (Polygon-compatible stock aggs) — server-only. Optional FMP/history backup.
# https://massive.com/dashboard — never expose to browser.
# MASSIVE_API_KEY=

# FlashAlpha Lab (GEX/levels) — server-only. Free ≈ 5 req/day, individual stocks only (not SPY).
# Do NOT poll every 15m on free. See docs/API_PROVIDERS_EVAL.md.
# https://flashalpha.com — never expose to browser.
# FLASHALPHA_API_KEY=

# ── Stripe Billing (Payments + Billing + Invoicing-ready; server-side only) ──
# Prefer a RESTRICTED key (rk_...). Never expose to the browser/Vite.
# STRIPE_SECRET_KEY=
# Webhook signing secret (stripe listen / Dashboard endpoint → whsec_...)
# STRIPE_WEBHOOK_SECRET=
# Public origin used for Checkout success/cancel redirects.
# APP_BASE_URL=https://your-app.example
# Price catalog: create Products (one per tier) + Prices in the Stripe
# Dashboard, then map their price_ IDs here. INTERVAL ∈ MONTHLY|ANNUAL|ONETIME.
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_ANNUAL=price_xxx
# STRIPE_PRICE_DESK_ONETIME=price_xxx   # example one-time purchase price
# Set to any value once the Customer Portal is activated in the Dashboard.
# STRIPE_PORTAL_ENABLED=1
# Desks behind a subscription when billing is configured (comma-separated).
# Default: ksa (the only desk backed by a paid, budget-tracked vendor feed).
# Use "none" to disable gating entirely.
# BILLING_GATED_DESKS=ksa
# Keep desk access during failed-payment dunning? (default: yes)
# Set to 1 to lock desks as soon as a payment fails.
# BILLING_LOCK_ON_PAST_DUE=0
# HMAC secret for auth session cookies. Auto-generated into .data/auth-secret.txt
# when absent — set explicitly for multi-instance deployments.
# AUTH_SECRET=

# ── Security / ops ───────────────────────────────────────────────────────────
# Explicit proxy trust (fail-closed; boolean "trust all" is no longer supported).
# Prefer the exact ingress allowlist, or one hop when the platform does not
# publish stable edge ranges:
#   TRUST_PROXY_CIDRS=10.0.0.0/8,fd00::/8
#   TRUST_PROXY_HOPS=1
# Legacy TRUST_PROXY=1 maps to TRUST_PROXY_HOPS=1 with a deprecation warning.
# Structured log level for server logs (pino). Logs redact cookies,
# authorization headers and credential fields; never raise above 'info' in prod.
# LOG_LEVEL=info
